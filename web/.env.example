# ============================================================================
# ANNE TMAIL - Web Environment Variables (contoh)
# ============================================================================
# Salin file ini menjadi `.env.local` lalu isi dengan nilai asli.
# Di Vercel: Settings > Environment Variables (Production & Preview).
# ============================================================================

# ---- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Anon/public key (aman dipakai di browser, tunduk pada RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Service role key: RAHASIA. Hanya untuk API routes server-side.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Cron -----------------------------------------------------------------
# Dipakai Vercel Cron untuk otorisasi GET /api/cron/cleanup
# (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-to-a-long-random-string